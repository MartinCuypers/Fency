rules_version = '2';
// Règles de sécurité de Fency. À déployer dans la console Firebase (Firestore > Règles)
// ou avec `firebase deploy --only firestore:rules`.
// NON TESTÉES contre un vrai projet : à valider avec l'émulateur avant mise en production.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(plan) { return signedIn() && request.auth.uid in plan.memberIds; }

    match /plans/{planId} {
      // Partage par lien : connaître l'identifiant (aléatoire) du plan permet de le lire.
      allow get: if signedIn();
      // Lister : uniquement ses propres plans (requête memberIds array-contains uid).
      allow list: if isMember(resource.data);
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid];
      // Un membre modifie le contenu mais ni le propriétaire ni la liste des membres…
      allow update: if isMember(resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.memberIds == resource.data.memberIds;
      // …et un utilisateur connecté peut seulement s'ajouter lui-même (rejoindre par lien).
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.auth.uid in request.resource.data.memberIds;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /features/{featureId} {
        allow read, write: if isMember(get(/databases/$(database)/documents/plans/$(planId)).data);
      }
    }
  }
}
